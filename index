    function uniqueTracks(tracks) {
      const seen = new Set();

      return tracks.filter((track) => {
        if (!track?.id || seen.has(track.id)) return false;
        seen.add(track.id);
        return true;
      });
    }

    function chunk(array, size) {
      const result = [];
      for (let index = 0; index < array.length; index += size) {
        result.push(array.slice(index, index + size));
      }
      return result;
    }

    const ARTIST_GENRE_CACHE_KEY = "ih_radio_artist_genre_cache_v1";
    const ARTIST_GENRE_CACHE_MAX_AGE = 30 * 24 * 60 * 60 * 1000;

    function readArtistGenreCache() {
      try {
        const parsed = JSON.parse(localStorage.getItem(ARTIST_GENRE_CACHE_KEY) || "{}");
        return parsed && typeof parsed === "object" ? parsed : {};
      } catch {
        return {};
      }
    }

    function writeArtistGenreCache(cache) {
      try {
        localStorage.setItem(ARTIST_GENRE_CACHE_KEY, JSON.stringify(cache));
      } catch (error) {
        console.warn("Artist genre cache could not be saved:", error.message);
      }
    }

    async function fetchArtistGenreMap(tracks) {
      const artistIds = [
        ...new Set(
          tracks.flatMap((track) =>
            (track.artists || []).map((artist) => artist.id).filter(Boolean)
          )
        )
      ];

      const genreMap = new Map();
      const cache = readArtistGenreCache();
      const now = Date.now();
      const missingIds = [];

      for (const artistId of artistIds) {
        const cached = cache[artistId];
        if (
          cached &&
          Array.isArray(cached.genres) &&
          now - Number(cached.savedAt || 0) < ARTIST_GENRE_CACHE_MAX_AGE
        ) {
          genreMap.set(artistId, cached.genres);
        } else {
          missingIds.push(artistId);
        }
      }

      if (missingIds.length) {
        setLoading(
          true,
          `Sorting stations… ${artistIds.length - missingIds.length}/${artistIds.length} artists cached`
        );
      }

      for (let index = 0; index < missingIds.length; index += 1) {
        const artistId = missingIds[index];
        try {
          const artist = await spotifyApi(`artists/${encodeURIComponent(artistId)}`);
          const genres = (artist?.genres || []).map((genre) => genre.toLowerCase());
          genreMap.set(artistId, genres);
          cache[artistId] = { genres, savedAt: Date.now() };

          if (index % 10 === 9 || index === missingIds.length - 1) {
            writeArtistGenreCache(cache);
            setLoading(
              true,
              `Sorting stations… ${artistIds.length - missingIds.length + index + 1}/${artistIds.length} artists`
            );
          }

          // Deliberately avoid a burst of hundreds of simultaneous requests.
          await sleep(140);
        } catch (error) {
          console.warn(`Artist lookup failed for ${artistId}:`, error.message);
          genreMap.set(artistId, []);
          cache[artistId] = { genres: [], savedAt: Date.now() };
          writeArtistGenreCache(cache);

          if (/quota|rate-limit|cooling down/i.test(error.message)) {
            throw error;
          }
        }
      }

      return genreMap;
    }

    function trackGenres(track, genreMap) {
      return [
        ...new Set(
          (track.artists || []).flatMap(
            (artist) => genreMap.get(artist.id) || []
          )
        )
      ];
    }

    function matchesAnyGenre(genres, terms) {
      return genres.some((genre) =>
        terms.some((term) => genre.includes(term))
      );
    }

    function stationScore(track, genreMap, stationId) {
      const genres = trackGenres(track, genreMap);
      const artists = (track.artists || []).map((artist) => (artist.name || "").toLowerCase());
      let score = 0;

      for (const genre of genres) {
        for (const term of GENRE_RULES[stationId] || []) {
          if (genre === term) score += 5;
          else if (genre.includes(term) || term.includes(genre)) score += 2;
        }
      }

      if (artists.some((name) => (ARTIST_STATION_HINTS[stationId] || []).includes(name))) score += 6;

      // Keep broad labels from swallowing more specific stations.
      if (stationId === "pop" && genres.some((g) => /hip hop|rap|punk|hardcore/.test(g))) score -= 4;
      if (stationId === "alternative" && genres.some((g) => /contemporary r&b|neo soul|trap|drill/.test(g))) score -= 3;
      if (stationId === "soul" && genres.some((g) => /punk|hardcore|metal/.test(g))) score -= 5;
      if (stationId === "skate" && genres.some((g) => /quiet storm|chamber pop|jazz standards/.test(g))) score -= 4;

      return score;
    }

    function rankForStation(tracks, genreMap, stationId) {
      return tracks
        .map((track, affinityIndex) => ({
          track,
          affinityIndex,
          score: stationScore(track, genreMap, stationId)
        }))
        .filter((item) => item.score >= 2)
        .sort((a, b) => b.score - a.score || a.affinityIndex - b.affinityIndex)
        .map((item) => item.track);
    }

    async function fetchTopTracks(timeRange, limit = 50) {
      const data = await spotifyApi(
        `me/top/tracks?time_range=${encodeURIComponent(timeRange)}&limit=${Math.min(limit, 50)}`
      );
      return data.items || [];
    }

    async function fetchSavedTracks(maxTracks = 100) {
      const tracks = [];
      let offset = 0;
      const pageSize = 50;

      while (tracks.length < maxTracks) {
        const data = await spotifyApi(
          `me/tracks?limit=${pageSize}&offset=${offset}`
        );
        const items = data?.items || [];
        tracks.push(...items.map((item) => item.track).filter(Boolean));
        if (items.length < pageSize || !data?.next) break;
        offset += pageSize;
      }

      return tracks.slice(0, maxTracks);
    }

