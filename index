    function selectStation(stationId, tuneNow = true) {
      if (!state.stations[stationId]) return;

      state.activeStationId = stationId;
      state.currentIndex = -1;

      const station = getStationDefinition(stationId);
      elements.activeStationName.textContent = `${station.frequency} FM — ${station.name}`;
      elements.activeStationDescription.textContent = `${station.slogan} ${station.description}`;

      document.querySelectorAll(".station-card").forEach((card) => {
