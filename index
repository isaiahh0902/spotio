<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#101114" />
  <title>IH Radio</title>

  <style>
    :root {
      --bg: #0d0f12;
      --panel: #15181d;
      --panel-2: #1c2027;
      --line: #2c323b;
      --text: #f5f7fa;
      --muted: #a6afbd;
      --accent: #ffcf33;
      --accent-text: #171200;
      --danger: #ff6b6b;
      --success: #4fd18b;
      --shadow: 0 18px 55px rgba(0, 0, 0, 0.35);
      --radius: 22px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      color-scheme: dark;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at 8% 0%, rgba(255, 207, 51, 0.13), transparent 28rem),
        linear-gradient(180deg, #111419 0%, var(--bg) 35%);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;
    }

    button,
    input {
      font: inherit;
    }

    button {
      color: inherit;
    }

    a {
      color: inherit;
    }

    .app {
      width: min(1180px, calc(100% - 28px));
      margin: 0 auto;
      padding: 26px 0 56px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 24px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 48px;
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--accent);
      color: var(--accent-text);
      font-weight: 900;
      letter-spacing: -0.08em;
      box-shadow: 0 0 0 7px rgba(255, 207, 51, 0.08);
    }

    .brand-copy h1 {
      margin: 0;
      font-size: clamp(1.35rem, 3vw, 2rem);
      letter-spacing: -0.04em;
    }

    .brand-copy p {
      margin: 3px 0 0;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .button {
      border: 1px solid var(--line);
      background: var(--panel-2);
      border-radius: 999px;
      padding: 10px 15px;
      cursor: pointer;
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .button:hover:not(:disabled) {
      transform: translateY(-1px);
      border-color: #454e5c;
    }

    .button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .button.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-text);
      font-weight: 800;
    }

    .button.ghost {
      background: transparent;
    }

    .button.danger {
      color: #ffd2d2;
      border-color: rgba(255, 107, 107, 0.4);
    }

    .status-banner {
      display: none;
      margin-bottom: 18px;
      padding: 13px 16px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--panel);
      color: var(--muted);
    }

    .status-banner.show {
      display: block;
    }

    .status-banner.error {
      border-color: rgba(255, 107, 107, 0.55);
      color: #ffd0d0;
    }

    .status-banner.success {
      border-color: rgba(79, 209, 139, 0.45);
      color: #c8ffe0;
    }

    .login-panel {
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 24px;
      padding: clamp(24px, 5vw, 52px);
      border: 1px solid var(--line);
      border-radius: 30px;
      background:
        linear-gradient(130deg, rgba(255, 207, 51, 0.12), transparent 52%),
        var(--panel);
      box-shadow: var(--shadow);
    }

    .login-panel h2 {
      margin: 0 0 12px;
      max-width: 760px;
      font-size: clamp(2rem, 6vw, 4.6rem);
      line-height: 0.95;
      letter-spacing: -0.065em;
    }

    .login-panel p {
      max-width: 700px;
      margin: 0 0 22px;
      color: var(--muted);
      font-size: 1.02rem;
      line-height: 1.65;
    }

    .setup-card {
      align-self: stretch;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 22px;
      background: rgba(9, 11, 14, 0.5);
    }

    .setup-card h3 {
      margin: 0 0 12px;
      font-size: 1rem;
    }

    .setup-card ol {
      margin: 0;
      padding-left: 19px;
      color: var(--muted);
      line-height: 1.65;
      font-size: 0.9rem;
    }

    .setup-card code {
      color: var(--text);
      overflow-wrap: anywhere;
    }

    .radio-app {
      display: none;
    }

    .radio-app.show {
      display: block;
    }

    .profile-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 18px;
      padding: 14px 16px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: rgba(21, 24, 29, 0.88);
    }

    .profile {
      display: flex;
      align-items: center;
      min-width: 0;
      gap: 12px;
    }

    .profile img,
    .profile-placeholder {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      object-fit: cover;
      background: var(--panel-2);
      border: 1px solid var(--line);
    }

    .profile-placeholder {
      display: grid;
      place-items: center;
      color: var(--muted);
    }

    .profile strong,
    .profile span {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .profile span {
      color: var(--muted);
      font-size: 0.85rem;
      margin-top: 2px;
    }

    .station-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 18px;
    }

    .station-card {
      position: relative;
      min-height: 140px;
      padding: 16px;
      text-align: left;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: var(--panel);
      cursor: pointer;
      overflow: hidden;
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .station-card:hover {
      transform: translateY(-2px);
      border-color: #48515e;
    }

    .station-card.active {
      border-color: var(--accent);
      background:
        linear-gradient(145deg, rgba(255, 207, 51, 0.16), transparent 75%),
        var(--panel);
    }

    .station-card .station-frequency {
      display: block;
      margin-bottom: 7px;
      color: var(--accent);
      font-size: 1.25rem;
      font-weight: 950;
      letter-spacing: -0.04em;
    }

    .station-card .station-call-sign {
      display: inline-block;
      margin-top: 9px;
      padding: 4px 8px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 999px;
      color: var(--muted);
      font-size: .65rem;
      font-weight: 850;
      letter-spacing: .12em;
    }

    .station-card .number {
      display: block;
      margin-bottom: 24px;
      color: var(--muted);
      font-size: 0.75rem;
      letter-spacing: 0.13em;
    }

    .station-card strong {
      display: block;
      font-size: 1.05rem;
      letter-spacing: -0.025em;
    }

    .station-card small {
      display: block;
      margin-top: 6px;
      color: var(--muted);
      line-height: 1.35;
    }

    .station-card .count {
      position: absolute;
      top: 13px;
      right: 13px;
      padding: 4px 8px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.06);
      color: var(--muted);
      font-size: 0.72rem;
    }

    .main-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
      gap: 18px;
    }

    .now-playing,
    .queue-panel {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--panel);
      overflow: hidden;
    }

    .now-playing {
      padding: 20px;
    }

    .station-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 17px;
    }

    .eyebrow {
      margin: 0 0 4px;
      color: var(--accent);
      font-weight: 800;
      font-size: 0.73rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .station-heading h2 {
      margin: 0;
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      letter-spacing: -0.05em;
    }

    .station-heading p {
      margin: 6px 0 0;
      color: var(--muted);
    }

    .player-layout {
      display: grid;
      grid-template-columns: minmax(200px, 330px) 1fr;
      gap: 24px;
      align-items: center;
    }

    .cover-wrap {
      position: relative;
      aspect-ratio: 1;
      border-radius: 24px;
      overflow: hidden;
      background:
        radial-gradient(circle at 35% 28%, rgba(255, 207, 51, 0.32), transparent 28%),
        var(--panel-2);
      border: 1px solid var(--line);
    }

    .cover-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
    }

    .cover-wrap img.show {
      display: block;
    }

    .cover-placeholder {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 20px;
      text-align: center;
      color: var(--muted);
      font-weight: 700;
    }

    .cover-placeholder.hide {
      display: none;
    }

    .track-info {
      min-width: 0;
    }

    .track-info h3 {
      margin: 0;
      font-size: clamp(1.7rem, 5vw, 3.2rem);
      line-height: 1;
      letter-spacing: -0.06em;
      overflow-wrap: anywhere;
    }

    .track-info .artist {
      margin: 10px 0 5px;
      color: var(--muted);
      font-size: 1.05rem;
    }

    .track-info .album {
      margin: 0 0 22px;
      color: var(--muted);
      font-size: 0.86rem;
    }

    .progress-shell {
      margin-bottom: 18px;
    }

    .progress {
      width: 100%;
      accent-color: var(--accent);
    }

    .times {
      display: flex;
      justify-content: space-between;
      margin-top: 4px;
      color: var(--muted);
      font-variant-numeric: tabular-nums;
      font-size: 0.78rem;
    }

    .controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .icon-button {
      display: grid;
      place-items: center;
      width: 46px;
      height: 46px;
      border: 1px solid var(--line);
      border-radius: 50%;
      background: var(--panel-2);
      cursor: pointer;
    }

    .icon-button.primary {
      width: 58px;
      height: 58px;
      border-color: var(--accent);
      background: var(--accent);
      color: var(--accent-text);
      font-size: 1.15rem;
    }

    .icon-button.active {
      color: var(--accent);
      border-color: rgba(255, 207, 51, 0.55);
    }

    .volume-row {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-top: 16px;
      color: var(--muted);
      font-size: 0.84rem;
    }

    .volume-row input {
      width: min(220px, 100%);
      accent-color: var(--accent);
    }

    .playback-note {
      margin: 16px 0 0;
      color: var(--muted);
      font-size: 0.82rem;
      line-height: 1.45;
    }

    .queue-panel {
      min-height: 600px;
      display: flex;
      flex-direction: column;
    }

    .queue-header {
      padding: 18px;
      border-bottom: 1px solid var(--line);
    }

    .queue-header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .queue-header h2 {
      margin: 0;
      font-size: 1.2rem;
      letter-spacing: -0.03em;
    }

    .queue-header p {
      margin: 5px 0 0;
      color: var(--muted);
      font-size: 0.84rem;
    }

    .queue {
      margin: 0;
      padding: 7px;
      list-style: none;
      overflow-y: auto;
      max-height: 650px;
    }

    .queue-empty {
      padding: 36px 18px;
      color: var(--muted);
      text-align: center;
      line-height: 1.55;
    }

    .queue-item {
      display: grid;
      grid-template-columns: 28px 48px minmax(0, 1fr) auto;
      gap: 10px;
      align-items: center;
      padding: 9px;
      border-radius: 13px;
      cursor: pointer;
      transition: background 140ms ease;
    }

    .queue-item:hover {
      background: transparent;
    }

    .queue-item { cursor: default; }

    .live-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      border: 1px solid rgba(255, 207, 51, 0.45);
      border-radius: 999px;
      background: rgba(255, 207, 51, 0.1);
      color: var(--accent);
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.12em;
    }

    .live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: currentColor;
      box-shadow: 0 0 0 5px rgba(255, 207, 51, 0.1);
      animation: livePulse 1.5s ease-in-out infinite;
    }

    @keyframes livePulse {
      50% { opacity: 0.42; transform: scale(0.82); }
    }

    .queue-item.active {
      background: rgba(255, 207, 51, 0.1);
    }

    .queue-rank {
      color: var(--muted);
      text-align: center;
      font-size: 0.8rem;
      font-variant-numeric: tabular-nums;
    }

    .queue-item img {
      width: 48px;
      height: 48px;
      border-radius: 8px;
      object-fit: cover;
      background: var(--panel-2);
    }

    .queue-text {
      min-width: 0;
    }

    .queue-text strong,
    .queue-text span {
      display: block;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .queue-text strong {
      font-size: 0.88rem;
    }

    .queue-text span {
      margin-top: 3px;
      color: var(--muted);
      font-size: 0.76rem;
    }

    .queue-duration {
      color: var(--muted);
      font-size: 0.76rem;
      font-variant-numeric: tabular-nums;
    }

    .loading {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: var(--muted);
    }

    .spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, 0.18);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 750ms linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .hidden {
      display: none !important;
    }

    @media (max-width: 900px) {
      .login-panel,
      .main-grid {
        grid-template-columns: 1fr;
      }

      .station-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .station-card:first-child {
        grid-column: 1 / -1;
      }

      .queue-panel {
        min-height: 0;
      }

      .queue {
        max-height: none;
      }
    }

    @media (max-width: 650px) {
      .app {
        width: min(100% - 18px, 1180px);
        padding-top: 14px;
      }

      .topbar,
      .profile-strip {
        align-items: flex-start;
        flex-direction: column;
      }

      .top-actions {
        justify-content: flex-start;
      }

      .login-panel {
        padding: 23px;
      }

      .player-layout {
        grid-template-columns: 1fr;
      }

      .cover-wrap {
        max-width: 340px;
        width: 100%;
        margin-inline: auto;
      }

      .station-grid {
        grid-template-columns: 1fr;
      }

      .station-card:first-child {
        grid-column: auto;
      }

      .station-card {
        min-height: 112px;
      }

      .station-card .number {
        margin-bottom: 14px;
      }

      .station-heading {
        flex-direction: column;
      }
    }
  </style>
</head>

<body>
  <main class="app">
    <header class="topbar">
      <div class="brand">
        <div class="brand-mark">IH</div>
        <div class="brand-copy">
          <h1>IH Radio</h1>
          <p>Your listening, broadcasting across three stations.</p>
        </div>
      </div>

      <div class="top-actions">
        <button class="button ghost hidden" id="refreshButton" type="button">
          Refresh stations
        </button>
        <button class="button danger hidden" id="logoutButton" type="button">
          Disconnect
        </button>
      </div>
    </header>

    <div class="status-banner" id="statusBanner" role="status" aria-live="polite"></div>

    <section class="login-panel" id="loginPanel">
      <div>
        <p class="eyebrow">PERSONAL SPOTIFY RADIO</p>
        <h2>Three stations. Up to 250 songs. No nonsense.</h2>
        <p>
          Connect Spotify to create a monthly Top 50 station and five genre stations
          using your own top tracks. Nothing requires a pasted access token.
        </p>
        <label style="display:block;max-width:560px;margin:0 0 14px;">
          <span style="display:block;margin-bottom:7px;font-weight:750;">Spotify Client ID</span>
          <input id="clientIdInput" type="text" autocomplete="off" spellcheck="false"
            placeholder="Paste the Client ID from your Spotify app"
            style="width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:14px;background:var(--panel-2);color:var(--text);" />
        </label>
        <button class="button primary" id="loginButton" type="button">
          Save Client ID & Connect
        </button>
      </div>

      <aside class="setup-card">
        <h3>Before you connect</h3>
        <ol>
          <li>Paste your Spotify Client ID into the box on this page.</li>
          <li>Add <code>https://isaiahh0902.github.io/THEradio/</code> as a Spotify Redirect URI.</li>
          <li>Serve the file through GitHub Pages or localhost—not <code>file://</code>.</li>
          <li>Spotify Premium is required for playback inside the browser.</li>
        </ol>
      </aside>
    </section>

    <section class="radio-app" id="radioApp">
      <div class="profile-strip">
        <div class="profile">
          <div class="profile-placeholder" id="profilePlaceholder">♪</div>
          <img class="hidden" id="profileImage" alt="" />
          <div>
            <strong id="profileName">Spotify listener</strong>
            <span id="profileMeta">Connected</span>
          </div>
        </div>

        <div class="loading hidden" id="loadingIndicator">
          <span class="spinner" aria-hidden="true"></span>
          <span id="loadingText">Building stations…</span>
        </div>
      </div>

      <nav class="station-grid" id="stationGrid" aria-label="Radio stations"></nav>

      <div class="main-grid">
        <section class="now-playing">
          <div class="station-heading">
            <div>
              <p class="eyebrow">NOW TUNED TO</p>
              <h2 id="activeStationName">Heat Check Radio</h2>
              <p id="activeStationDescription">The songs running your listening right now.</p>
            </div>

            <button class="button" id="savePlaylistButton" type="button" disabled>
              Save as playlist
            </button>
          </div>

          <div class="player-layout">
            <div class="cover-wrap">
              <div class="cover-placeholder" id="coverPlaceholder">Choose a song from the queue</div>
              <img id="coverImage" alt="Current album artwork" />
            </div>

            <div class="track-info">
              <h3 id="trackTitle">Nothing playing</h3>
              <p class="artist" id="trackArtist">Select a track</p>
              <p class="album" id="trackAlbum">IH Radio</p>

              <div class="progress-shell">
                <input
                  class="progress"
                  id="progressRange"
                  type="range"
                  min="0"
                  max="1000"
                  value="0"
                  aria-label="Playback position"
                  disabled
                />
                <div class="times">
                  <span id="currentTime">0:00</span>
                  <span id="durationTime">0:00</span>
                </div>
              </div>

              <div class="controls">
                <span class="live-pill"><span class="live-dot"></span>LIVE — NO SKIPS</span>
                <a
                  class="button"
                  id="openSpotifyButton"
                  href="#"
                  target="_blank"
                  rel="noreferrer"
                  aria-disabled="true"
                >
                  Open current song
                </a>
              </div>

              <label class="volume-row">
                Volume
                <input id="volumeRange" type="range" min="0" max="100" value="55" />
              </label>

              <p class="playback-note" id="playbackNote">
                Spotify Premium is needed for live in-browser radio. Songs cannot be paused, skipped, or selected; change stations to hear something else.
              </p>
            </div>
          </div>
        </section>

        <aside class="queue-panel">
          <div class="queue-header">
            <div class="queue-header-top">
              <h2>Station queue</h2>
              <span class="eyebrow" id="queueCount">0 TRACKS</span>
            </div>
            <p id="queueSubtitle">Your station will appear here.</p>
          </div>

          <ol class="queue" id="queueList">
            <li class="queue-empty">Connect Spotify to build your stations.</li>
          </ol>
        </aside>
      </div>
    </section>
  </main>

  <script src="https://sdk.scdn.co/spotify-player.js"></script>
  <script>
    /*
      ==============================================================
      REQUIRED SETUP
      ==============================================================

      1. Replace the value below with your Spotify app's Client ID.
      2. In Spotify Developer Dashboard, add the exact URL of this page
         as a Redirect URI.

         GitHub Pages example:
         https://YOUR-USERNAME.github.io/YOUR-REPOSITORY/

      3. Do NOT add a Client Secret. Browser apps use PKCE.

      IMPORTANT:
      The redirect URI must match Spotify's dashboard exactly,
      including trailing slash and capitalization.
    */

    const CLIENT_ID_STORAGE_KEY = "ih_radio_client_id";
    let CLIENT_ID = localStorage.getItem(CLIENT_ID_STORAGE_KEY) || "";

    /*
      By default the app uses the current page, without query parameters.
      This makes it work on GitHub Pages as long as the exact page URL is
      registered in Spotify's dashboard.
    */
    const REDIRECT_URI = (() => {
      const normalizedPath = window.location.pathname.replace(/index\.html$/i, "");
      return window.location.origin + normalizedPath;
    })();

