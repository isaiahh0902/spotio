    function renderQueue() {
      const tracks = getActiveStationTracks();
      elements.queueList.innerHTML = "";
      elements.queueCount.textContent = `${tracks.length} TRACK${tracks.length === 1 ? "" : "S"}`;
      elements.queueSubtitle.textContent =
        tracks.length > 0
          ? "Live rotation — the highlighted song is currently on air."
          : "Spotify did not find enough matching tracks in your top listening.";

      if (!tracks.length) {
        elements.queueList.innerHTML = `
          <li class="queue-empty">
            This station is empty. Spotify did not return enough tracks for this station.
          </li>
        `;
        return;
      }

      tracks.forEach((track, index) => {
        const item = document.createElement("li");
        item.className = "queue-item";

        if (index === state.currentIndex) {
          item.classList.add("active");
        }

        item.dataset.index = String(index);
        item.setAttribute("aria-label", `${track.name} by ${formatArtists(track)}`);

        const image =
          track.album?.images?.[track.album.images.length > 1 ? 1 : 0]?.url ||
          track.album?.images?.[0]?.url ||
          "";

        item.innerHTML = `
          <span class="queue-rank">${index + 1}</span>
          ${
            image
              ? `<img src="${escapeAttribute(image)}" alt="" loading="lazy" />`
              : `<span class="profile-placeholder">♪</span>`
          }
          <span class="queue-text">
            <strong>${escapeHtml(track.name || "Unknown track")}</strong>
            <span>${escapeHtml(formatArtists(track))}</span>
          </span>
          <span class="queue-duration">${formatMilliseconds(track.duration_ms || 0)}</span>
        `;

        elements.queueList.appendChild(item);
      });
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function escapeAttribute(value) {
      return escapeHtml(value);
    }

    function formatArtists(track) {
      return (track.artists || [])
        .map((artist) => artist.name)
        .filter(Boolean)
        .join(", ") || "Unknown artist";
    }

    function formatMilliseconds(milliseconds) {
      if (!Number.isFinite(milliseconds) || milliseconds <= 0) {
        return "0:00";
      }

      const totalSeconds = Math.floor(milliseconds / 1000);
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      return `${minutes}:${String(seconds).padStart(2, "0")}`;
    }

    function resetCurrentTrackDisplay() {
      elements.trackTitle.textContent = "Nothing playing";
      elements.trackArtist.textContent = "Select a track";
      elements.trackAlbum.textContent = "IH Radio";
      elements.coverImage.classList.remove("show");
      elements.coverImage.removeAttribute("src");
      elements.coverPlaceholder.classList.remove("hide");
      elements.progressRange.value = "0";
      elements.progressRange.disabled = true;
      elements.currentTime.textContent = "0:00";
      elements.durationTime.textContent = "0:00";
      elements.openSpotifyButton.href = "#";
      elements.openSpotifyButton.setAttribute("aria-disabled", "true");
      stopProgressTimer();
    }

    function updateCurrentTrackDisplay(track) {
      if (!track) {
        resetCurrentTrackDisplay();
        return;
      }

      elements.trackTitle.textContent = track.name || "Unknown track";
      elements.trackArtist.textContent = formatArtists(track);
      elements.trackAlbum.textContent = track.album?.name || "Spotify";
      elements.durationTime.textContent = formatMilliseconds(track.duration_ms || 0);

      const image = track.album?.images?.[0]?.url;
      if (image) {
        elements.coverImage.src = image;
        elements.coverImage.classList.add("show");
        elements.coverPlaceholder.classList.add("hide");
      } else {
        elements.coverImage.classList.remove("show");
        elements.coverPlaceholder.classList.remove("hide");
      }

      const spotifyUrl = track.external_urls?.spotify;
      if (spotifyUrl) {
        elements.openSpotifyButton.href = spotifyUrl;
        elements.openSpotifyButton.removeAttribute("aria-disabled");
      } else {
        elements.openSpotifyButton.href = "#";
        elements.openSpotifyButton.setAttribute("aria-disabled", "true");
      }

      elements.progressRange.disabled = true;
      renderQueue();
    }

    function currentTrack() {
      return getActiveStationTracks()[state.currentIndex] || null;
    }

    function getLiveStationPosition(stationId) {
      const tracks = state.stations[stationId] || [];
      if (!tracks.length) return { index: -1, positionMs: 0 };

      const cycleMs = tracks.reduce((sum, track) => sum + Math.max(1000, track.duration_ms || 180000), 0);
      let elapsed = (Date.now() - state.stationEpochs[stationId]) % cycleMs;
      if (elapsed < 0) elapsed += cycleMs;

      for (let index = 0; index < tracks.length; index++) {
        const duration = Math.max(1000, tracks[index].duration_ms || 180000);
        if (elapsed < duration) return { index, positionMs: elapsed };
        elapsed -= duration;
      }
      return { index: 0, positionMs: 0 };
    }

    async function tuneToLiveStation() {
      const tracks = getActiveStationTracks();
      if (!tracks.length || state.isTuning) return;

      const { index, positionMs } = getLiveStationPosition(state.activeStationId);
      const track = tracks[index];
      if (!track) return;

      state.currentIndex = index;
      updateCurrentTrackDisplay(track);

      if (!state.playerReady || !state.deviceId) {
        elements.playbackNote.textContent = "This station is live. Switch stations once Spotify playback is ready.";
        return;
      }

      state.isTuning = true;
      try {
        await spotifyApi(`me/player/play?device_id=${encodeURIComponent(state.deviceId)}`, {
          method: "PUT",
          body: JSON.stringify({ uris: [track.uri], position_ms: Math.floor(positionMs) })
        });
        startProgressTimer();
      } catch (error) {
        showStatus(`${error.message} Switch stations again to retry live playback.`, "error");
      } finally {
        state.isTuning = false;
      }
    }

    async function playTrackAtIndex(index) {
      const tracks = getActiveStationTracks();
      const track = tracks[index];

      if (!track) return;

      state.currentIndex = index;
      updateCurrentTrackDisplay(track);

      if (!state.playerReady || !state.deviceId) {
        showStatus(
          "The browser player is unavailable. Use “Open in Spotify” for this track.",
          "error"
        );
        return;
      }

      try {
        await spotifyApi(
          `me/player/play?device_id=${encodeURIComponent(state.deviceId)}`,
          {
            method: "PUT",
            body: JSON.stringify({
              uris: [track.uri]
            })
          }
        );

        startProgressTimer();
      } catch (error) {
        showStatus(
          `${error.message} You can still open the song in Spotify.`,
          "error"
        );
      }
    }

    async function togglePlayback() {
      if (state.currentIndex < 0) {
        const tracks = getActiveStationTracks();
        if (!tracks.length) return;

        const firstIndex = state.isShuffled
          ? Math.floor(Math.random() * tracks.length)
          : 0;

        await playTrackAtIndex(firstIndex);
        return;
      }

      if (!state.playerReady || !state.player) {
        const track = currentTrack();
        if (track?.external_urls?.spotify) {
          window.open(track.external_urls.spotify, "_blank", "noopener");
        }
        return;
      }

      try {
        await state.player.togglePlay();
      } catch (error) {
        showStatus(error.message, "error");
      }
    }

    async function playNext() {
      const tracks = getActiveStationTracks();
      if (!tracks.length) return;

      let nextIndex;

      if (state.isShuffled && tracks.length > 1) {
        do {
          nextIndex = Math.floor(Math.random() * tracks.length);
        } while (nextIndex === state.currentIndex);
      } else {
        nextIndex = (state.currentIndex + 1 + tracks.length) % tracks.length;
      }

      await playTrackAtIndex(nextIndex);
    }

    async function playPrevious() {
      const tracks = getActiveStationTracks();
      if (!tracks.length) return;

      const previousIndex =
        (state.currentIndex - 1 + tracks.length) % tracks.length;

      await playTrackAtIndex(previousIndex);
    }

    function toggleShuffle() {
      state.isShuffled = !state.isShuffled;
      elements.shuffleButton.classList.toggle("active", state.isShuffled);
      elements.shuffleButton.setAttribute(
        "aria-pressed",
        String(state.isShuffled)
      );

      showStatus(
        state.isShuffled ? "Shuffle is on." : "Shuffle is off.",
        "success"
      );
    }

    async function seekPlayback() {
      if (!state.playerReady || !state.playerState) return;

      const position =
        (Number(elements.progressRange.value) / 1000) *
        state.playerState.duration;

      try {
        await state.player.seek(position);
      } catch (error) {
        showStatus(error.message, "error");
      }
    }

    async function setVolume() {
      if (!state.playerReady || !state.player) return;

      try {
        await state.player.setVolume(
          Number(elements.volumeRange.value) / 100
        );
      } catch (error) {
        console.error(error);
      }
    }

    function startProgressTimer() {
      stopProgressTimer();

      state.progressTimer = window.setInterval(() => {
        if (!state.playerState || state.playerState.paused) return;

        const nextPosition = Math.min(
          state.playerState.position + 1000,
          state.playerState.duration
        );

        state.playerState.position = nextPosition;
        updateProgressDisplay();
      }, 1000);
    }

    function stopProgressTimer() {
      if (state.progressTimer) {
        window.clearInterval(state.progressTimer);
        state.progressTimer = null;
      }
    }

    function updateProgressDisplay() {
      const playerState = state.playerState;
      if (!playerState) return;

      const duration = playerState.duration || 0;
      const position = playerState.position || 0;
      const ratio = duration > 0 ? position / duration : 0;

      elements.progressRange.value = String(
        Math.max(0, Math.min(1000, Math.round(ratio * 1000)))
      );
      elements.currentTime.textContent = formatMilliseconds(position);
      elements.durationTime.textContent = formatMilliseconds(duration);
    }

    async function initializeSpotifyPlayer() {
      if (!window.Spotify || !isConnected()) return;

      const player = new Spotify.Player({
        name: "IH Radio Web Player",
        getOAuthToken: async (callback) => {
          try {
            callback(await getValidAccessToken());
          } catch (error) {
            showStatus(error.message, "error");
          }
        },
        volume: Number(elements.volumeRange.value) / 100,
        enableMediaSession: true
      });

      state.player = player;

      player.addListener("ready", async ({ device_id }) => {
        state.deviceId = device_id;
        state.playerReady = true;
        elements.playbackNote.textContent =
          "Browser playback is ready. This tab now appears as “IH Radio Web Player” in Spotify Connect.";

        try {
          await spotifyApi("me/player", {
            method: "PUT",
            body: JSON.stringify({
              device_ids: [device_id],
              play: true
            })
          });
        } catch (error) {
          /*
            Transfer can fail when no prior device is active. The first play
            request may still activate the browser device.
          */
          console.warn("Playback transfer:", error.message);
        }
        await tuneToLiveStation();
      });

      player.addListener("not_ready", ({ device_id }) => {
        if (state.deviceId === device_id) {
          state.playerReady = false;
          state.deviceId = null;
        }
      });

      player.addListener("player_state_changed", (playerState) => {
        if (!playerState) return;

        state.playerState = {
          position: playerState.position,
          duration: playerState.duration,
          paused: playerState.paused
        };

        const spotifyTrack = playerState.track_window?.current_track;
        if (spotifyTrack) {
          const tracks = getActiveStationTracks();
          const matchingIndex = tracks.findIndex(
            (track) => track.id === spotifyTrack.id
          );

          if (matchingIndex >= 0 && matchingIndex !== state.currentIndex) {
            state.currentIndex = matchingIndex;
            updateCurrentTrackDisplay(tracks[matchingIndex]);
          }
        }

        updateProgressDisplay();

        if (playerState.paused && state.currentIndex >= 0 && !state.isTuning) {
          window.setTimeout(() => tuneToLiveStation(), 350);
        } else {
          startProgressTimer();
        }

        if (
          playerState.paused &&
          playerState.position === 0 &&
          state.currentIndex >= 0
        ) {
          window.setTimeout(() => tuneToLiveStation(), 500);
        }
      });

      player.addListener("initialization_error", ({ message }) => {
        state.playerReady = false;
        showStatus(`Spotify player could not start: ${message}`, "error");
      });

      player.addListener("authentication_error", ({ message }) => {
        state.playerReady = false;
        showStatus(`Spotify player authentication failed: ${message}`, "error");
      });

      player.addListener("account_error", ({ message }) => {
        state.playerReady = false;
        elements.playbackNote.textContent =
          "Your account cannot use Spotify's browser player. Browse the stations and open songs in Spotify instead.";
        showStatus(`Spotify Premium playback unavailable: ${message}`, "error");
      });

      player.addListener("playback_error", ({ message }) => {
        showStatus(`Spotify playback failed: ${message}`, "error");
      });

      player.addListener("autoplay_failed", () => {
        showStatus(
          "Your browser blocked autoplay. Switch to another station once to begin the broadcast.",
          "error"
        );
      });

      const connected = await player.connect();
      if (!connected) {
        showStatus(
          "Spotify's browser player did not connect. Station browsing still works.",
          "error"
        );
      }
    }

    async function saveActiveStationAsPlaylist() {
      const tracks = getActiveStationTracks();
      const station = getStationDefinition(state.activeStationId);

      if (!tracks.length || !state.profile) return;

      const originalText = elements.savePlaylistButton.textContent;
      elements.savePlaylistButton.disabled = true;
      elements.savePlaylistButton.textContent = "Saving…";

      try {
        const playlist = await spotifyApi("me/playlists", {
          method: "POST",
          body: JSON.stringify({
            name: `IH Radio — ${station.name}`,
            description:
              `${station.description} Generated by IH Radio.`,
            public: false
          })
        });

        const uris = tracks.map((track) => track.uri).filter(Boolean);

        for (const uriChunk of chunk(uris, 100)) {
          await spotifyApi(`playlists/${playlist.id}/items`, {
            method: "POST",
            body: JSON.stringify({
              uris: uriChunk
            })
          });
        }

        showStatus(
          `Saved “${playlist.name}” to your Spotify library.`,
          "success"
        );
      } catch (error) {
        showStatus(`Could not save the playlist: ${error.message}`, "error");
      } finally {
        elements.savePlaylistButton.textContent = originalText;
        elements.savePlaylistButton.disabled = tracks.length === 0;
      }
    }

    function bindEvents() {
      elements.loginButton.addEventListener("click", loginWithSpotify);
      elements.logoutButton.addEventListener("click", clearSpotifySession);
      elements.refreshButton.addEventListener("click", buildStations);
      elements.savePlaylistButton.addEventListener(
        "click",
        saveActiveStationAsPlaylist
      );
      elements.volumeRange.addEventListener("input", setVolume);

      elements.openSpotifyButton.addEventListener("click", (event) => {
        if (
          elements.openSpotifyButton.getAttribute("aria-disabled") === "true"
        ) {
          event.preventDefault();
        }
      });
    }

    async function initializeApp() {
      bindEvents();
      if (elements.clientIdInput) elements.clientIdInput.value = CLIENT_ID;
      renderStations();

      try {
        await handleSpotifyRedirect();

        if (!isConnected()) {
          showDisconnectedView();
          setLoading(false);
          return;
        }

        showConnectedView();
        setLoading(true, "Loading your Spotify profile…");

        await loadProfile();
        await buildStations();

        /*
          The Spotify SDK may load before or after the app script.
          initializeSpotifyPlayer is also assigned to Spotify's required
          global callback below.
        */
        if (window.Spotify) {
          await initializeSpotifyPlayer();
        }
      } catch (error) {
        showStatus(error.message, "error");

        if (/session expired|refresh|invalid_grant|verifier/i.test(error.message)) {
          Object.values(STORAGE).forEach((key) => localStorage.removeItem(key));
          showDisconnectedView();
        }
      } finally {
        setLoading(false);
      }
    }

    window.onSpotifyWebPlaybackSDKReady = () => {
      if (isConnected() && !state.player) {
        initializeSpotifyPlayer().catch((error) => {
          showStatus(error.message, "error");
        });
      }
    };

    initializeApp();
  </script>
</body>
</html>
