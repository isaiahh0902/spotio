    async function buildStations() {
      const buildVersion = ++state.stationBuildVersion;
      setLoading(true, "Building a 250-song radio pool…");
      clearStatus();

      try {
        const [shortTerm, mediumTerm, longTerm, savedTracks] = await Promise.all([
          fetchTopTracks("short_term", 50),
          fetchTopTracks("medium_term", 50),
          fetchTopTracks("long_term", 50),
          fetchSavedTracks(150)
        ]);

        if (buildVersion !== state.stationBuildVersion) return;

        // One shared pool, capped at 250 unique songs. No artist-genre requests,
        // which keeps the app simple and dramatically reduces Spotify API traffic.
        const pool = uniqueTracks([
          ...shortTerm,
          ...mediumTerm,
          ...savedTracks,
          ...longTerm
        ]).slice(0, 250);

        const used = new Set();
        const takeUnique = (source, limit) => {
          const picked = [];
          for (const track of source) {
            if (!track?.id || used.has(track.id)) continue;
            used.add(track.id);
            picked.push(track);
            if (picked.length >= limit) break;
          }
          return picked;
        };

        const heatSource = uniqueTracks([...shortTerm, ...mediumTerm, ...pool]);
        const vaultSource = uniqueTracks([...savedTracks, ...pool]);
        const sidequestSource = uniqueTracks([...longTerm, ...pool]);

        const heat = takeUnique(heatSource, 85);
        const vault = takeUnique(vaultSource, 85);
        const sidequest = takeUnique(sidequestSource, 80);

        // If a source list was too small, distribute any unused pool tracks so the
        // combined station library still reaches as close to 250 as Spotify allows.
        const leftovers = pool.filter((track) => !used.has(track.id));
        const stations = { heat, vault, sidequest };
        const order = ["heat", "vault", "sidequest"];
        let cursor = 0;
        for (const track of leftovers) {
          const id = order[cursor % order.length];
          stations[id].push(track);
          cursor += 1;
        }

        state.stations = stations;
        state.currentIndex = -1;
        renderStations();
        selectStation(state.activeStationId, false);

        const totalTracks = Object.values(state.stations)
          .reduce((sum, tracks) => sum + tracks.length, 0);

        showStatus(
          `Three stations are live with ${totalTracks} unique songs total.`,
          "success"
        );
      } catch (error) {
        showStatus(error.message, "error");
        console.error(error);
      } finally {
        setLoading(false);
      }
    }

    function renderStations() {
      elements.stationGrid.innerHTML = "";

      STATION_DEFINITIONS.forEach((station, index) => {
        const tracks = state.stations[station.id] || [];
        const button = document.createElement("button");

        button.type = "button";
        button.className = "station-card";
        button.dataset.stationId = station.id;
        button.setAttribute("aria-pressed", String(station.id === state.activeStationId));

        if (station.id === state.activeStationId) {
          button.classList.add("active");
        }

        button.innerHTML = `
          <span class="number">STATION ${String(index + 1).padStart(2, "0")}</span>
          <span class="count">${tracks.length}</span>
          <span class="station-frequency">${escapeHtml(station.frequency)} FM</span>
          <strong>${escapeHtml(station.shortName)}</strong>
          <small>${escapeHtml(station.slogan)}</small>
          <span class="station-call-sign">${escapeHtml(station.callSign)}</span>
        `;

        button.addEventListener("click", () => selectStation(station.id));
        elements.stationGrid.appendChild(button);
      });
    }

    function getStationDefinition(stationId) {
